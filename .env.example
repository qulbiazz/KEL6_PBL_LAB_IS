# Database Configuration
DB_HOST=postgresql-youraccount.alwaysdata.net
DB_PORT=5432
DB_NAME=youraccount_inlet
DB_USER=youraccount
DB_PASSWORD=your_db_password

# Application Configuration
APP_ENV=production
APP_URL=https://yourdomain.alwaysdata.net
APP_NAME="InLet Laboratory"

# Upload Directory (relative to project root)
UPLOAD_DIR=uploads

# Session Configuration
SESSION_LIFETIME=7200

# Security (generate random string for production)
APP_KEY=your-random-32-character-key-here

# Email Configuration (SMTP)
# For Gmail: Use App Password (not regular password)
# Generate at: https://myaccount.google.com/apppasswords
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@polinema.ac.id
MAIL_FROM_NAME="INLET Lab"
