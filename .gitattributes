# Auto detect text files and perform LF normalization
* text=auto

# Prevent merge conflicts on generated files
composer.lock merge=ours
package-lock.json merge=ours
vendor/** merge=ours

# Prevent merge conflicts on uploaded files
uploads/** merge=ours

# Prevent merge conflicts on logs
logs/** merge=ours
*.log merge=ours

# Mark binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.tar.gz binary
